#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# La base (init-selkies-config) ne copie /defaults/autostart dans /config qu'au
# PREMIER demarrage. Sur un volume existant, une version corrigee de l'image ne
# serait donc jamais appliquee. On resynchronise ici a chaque boot : le fichier
# autostart est gere par l'image, pas par l'utilisateur.
#
# Ordre : apres init-selkies-config (qui pose les droits, ex. RESTART_APP) et
# avant svc-de (qui lance Openbox, donc l'autostart).

TARGET="${HOME}/.config/openbox/autostart"

if cmp -s /defaults/autostart "${TARGET}"; then
    exit 0
fi

echo "[dofus-init] Synchronisation de ${TARGET} depuis l'image"
if [ -e "${TARGET}" ]; then
    # cp sur un fichier existant conserve proprietaire et droits poses par la base.
    cp /defaults/autostart "${TARGET}"
else
    mkdir -p "$(dirname "${TARGET}")"
    cp /defaults/autostart "${TARGET}"
    chown abc:abc "$(dirname "${TARGET}")" "${TARGET}"
fi
